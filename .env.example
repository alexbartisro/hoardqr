# Postgres
DB_PASSWORD=changeme

# Only needed running the binary directly (e.g. local dev) — docker-compose.yml
# builds this itself from DB_PASSWORD above for the containers it starts.
# Keep ?sslmode=disable if you copy this elsewhere: it's not a security
# downgrade, it works around Go's lib/pq (used internally by the migration
# step) defaulting to requiring SSL, unlike every other Postgres client. See
# docker-compose.yml's DATABASE_URL comment or README.md for the full story.
DATABASE_URL=postgres://hoardqr:changeme@localhost:5432/hoardqr?sslmode=disable

# Session auth — only used when AUTH_REQUIRED=true
AUTH_REQUIRED=false
SESSION_SECRET=changeme

# MCP server auth token — the MCP process authenticates as one configured user
MCP_API_TOKEN=changeme

# Where uploaded photos are stored (§12). Defaults to /data/uploads if unset,
# matching docker-compose.yml's ./uploads:/data/uploads volume mount — a
# Docker deployment doesn't need this set at all. Only needed running the
# binary directly (e.g. local dev), e.g. UPLOAD_DIR=./uploads
#UPLOAD_DIR=/data/uploads

# Host-side paths for docker-compose.yml's volumes — where things live on
# your machine, not inside the containers (that's UPLOAD_DIR above, which is
# unrelated). Unlike every other variable in this file, these two are read
# directly by the `docker compose` CLI itself for its volume interpolation,
# not passed through to a container's environment — so they take effect
# under `docker compose up` even though nothing in Go ever sees them. Default
# to ./uploads and ./pgdata next to docker-compose.yml if unset. Set these if
# you keep all your containers' data under one shared path instead, e.g.
# HOST_UPLOADS_DIR=/srv/docker-data/hoardqr/uploads
#HOST_UPLOADS_DIR=./uploads
#HOST_PGDATA_DIR=./pgdata
